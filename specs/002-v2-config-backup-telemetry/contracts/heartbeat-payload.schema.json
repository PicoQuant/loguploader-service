{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picoquant.com/schemas/v2agent/heartbeat-payload.json",
  "title": "v2 agent heartbeat payload",
  "description": "The `payload` object of a POST /api/v2/products/{product}/telemetry with measurement_type=agent_status",
  "type": "object",
  "required": ["machine_id", "agent_version", "product", "serial_source", "os", "cycle"],
  "additionalProperties": false,
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "Windows MachineGuid, or the all-zero GUID if unreadable",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_version": {
      "type": "string",
      "description": "contents of the repo VERSION file, compiled in",
      "minLength": 1,
      "maxLength": 64
    },
    "product": {
      "type": "string",
      "enum": ["luminosa", "solira"]
    },
    "serial_source": {
      "type": "string",
      "enum": ["file", "unknown"],
      "description": "`file` = read from LastOpenSerial.txt; `unknown` = not readable"
    },
    "os": {
      "type": "object",
      "required": ["version", "build", "arch"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "maxLength": 64 },
        "build": { "type": "string", "maxLength": 32 },
        "arch": { "type": "string", "enum": ["x86_64", "aarch64", "x86"] }
      }
    },
    "cycle": {
      "type": "object",
      "required": ["started_utc", "duration_ms", "ok"],
      "additionalProperties": false,
      "properties": {
        "started_utc": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "ok": { "type": "boolean", "description": "true if the cycle completed without an internal error" }
      }
    },
    "blocked_backups": {
      "type": "array",
      "description": "watched files that could not be backed up this cycle (FR-007)",
      "items": {
        "type": "object",
        "required": ["file_key", "reason"],
        "additionalProperties": false,
        "properties": {
          "file_key": { "type": "string", "maxLength": 128 },
          "reason": { "type": "string", "enum": ["locked", "absent", "too_large", "rejected"] }
        }
      }
    },
    "last_backup_days": {
      "type": "object",
      "description": "optional freshness hint: file_key -> YYYY-MM-DD of last successful backup",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    }
  }
}
